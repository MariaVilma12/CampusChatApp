@using CampusChatApp.Services
@inject SessionService SessionService
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/home">Campus Chat</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/home">
                <span class="bi bi-house-door-fill me-2"></span>
                Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/profile">
                <span class="bi bi-person-fill me-2"></span>
                Profile
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/threads">
                <span class="bi bi-chat-left-text-fill me-2"></span>
                Threads
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/chats">
                <span class="bi bi-envelope-fill me-2"></span>
                Direct Chats
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/signin" @onclick="HandleSignInClick">
                <span class="bi bi-box-arrow-right me-2"></span>
                @(isSignedIn ? "Sign Out" : "Sign In")
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private bool isSignedIn;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            var user = await SessionService.GetCurrentUserAsync();
            isSignedIn = user is not null;
            return;
        }

        isSignedIn = await SessionService.GetCurrentUserAsync() is not null;
        StateHasChanged();
    }

    private async Task HandleSignInClick()
    {
        if (isSignedIn)
        {
            await SessionService.LogoutAsync();
            isSignedIn = false;
            Navigation.NavigateTo("/signin", forceLoad: true);
        }
        else
        {
            Navigation.NavigateTo("/signin");
        }
    }
}
