@namespace CampusChatApp.Components.Chat
@using CampusChatApp.Services
@using ChatMessageModel = CampusChatApp.Models.ChatMessage
@inject SessionService SessionService
@inject CampusChatStateService CampusChatStateService

<div class="input-group mt-3">
    <input type="text" class="form-control" @bind="_messageText" placeholder="Type a message..." />
    <button class="btn btn-primary" type="button" @onclick="SendMessage">Send</button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <div class="alert alert-danger mt-2">@_errorMessage</div>
}

@code {
    [Parameter]
    public int ChatId { get; set; }

    private string _messageText = string.Empty;
    private string _errorMessage = string.Empty;

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_messageText))
        {
            _errorMessage = "Message cannot be empty.";
            return;
        }

        var currentUser = await SessionService.GetCurrentUserAsync();
        if (currentUser is null)
        {
            _errorMessage = "Please sign in to send a message.";
            return;
        }

        if (currentUser.IsAuditUser)
        {
            _errorMessage = "Auditor profiles have read-only access to direct messages.";
            return;
        }

        ChatService.AddMessage(ChatId, new ChatMessageModel
        {
            Id = DateTime.UtcNow.Millisecond,
            SenderId = currentUser.Id,
            SenderName = currentUser.DisplayName,
            Text = _messageText.Trim(),
            SentAt = DateTime.Now
        });

        _messageText = string.Empty;
        _errorMessage = string.Empty;
        CampusChatStateService.NotifyChanged();
        await InvokeAsync(StateHasChanged);
    }
}
