@page "/signin"
@using CampusChat.Services
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject UserService UserService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Sign In</PageTitle>

<div class="container py-4">
    <h3>Sign In</h3>
    <p>Select a user:</p>

    @if (_users == null)
    {
        <p>Loading...</p>
    }
    else
    {
        @foreach (var user in _users)
        {
            <div style="margin-bottom:10px;">
                <button class="btn btn-primary" @onclick="() => SignInUser(user)">
                    @user.DisplayName
                </button>
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<User>? _users;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _users = UserService.GetAllUsers();
        var currentUser = await SessionService.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            Navigation.NavigateTo("/home");
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task SignInUser(User user)
    {
        await SessionService.SetCurrentUserAsync(user);
        Navigation.NavigateTo("/home");
    }
}

