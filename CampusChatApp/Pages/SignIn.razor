@page "/signin"
@using CampusChatApp.Services
@inject SessionService SessionService
@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>Choose a profile</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-9 col-lg-7">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">Campus Chat</span>
                        <h1 class="h3">Choose your profile</h1>
                        <p class="text-muted mb-0">Select a demo profile to enter the campus community.</p>
                    </div>

                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert-danger" role="alert">@_error</div>
                    }

                    <div class="list-group">
                        @foreach (var user in UserService.GetAllUsers().OrderBy(user => user.DisplayName))
                        {
                            <button type="button" class="list-group-item list-group-item-action d-flex align-items-center gap-3 p-3"
                                    @onclick="() => SelectProfile(user.Id)">
                                <span class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                      style="width: 48px; height: 48px; background: @user.AvatarColor;">
                                    @user.DisplayName.Substring(0, 1).ToUpperInvariant()
                                </span>
                                <span class="text-start flex-grow-1">
                                    <strong class="d-block">@user.DisplayName</strong>
                                    <small class="text-muted">@user.CourseStudying</small>
                                </span>
                                @if (user.IsAuditUser)
                                {
                                    <span class="badge text-bg-warning">Read-only auditor</span>
                                }
                                else if (user.StudyYear.HasValue)
                                {
                                    <span class="badge bg-primary-subtle text-primary">Year @user.StudyYear</span>
                                }
                            </button>
                        }
                    </div>

                    <p class="small text-muted text-center mt-4 mb-0">
                        Demo profiles are provided for this in-memory application. Do not use real or sensitive information.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _error = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && await SessionService.GetCurrentUserAsync() is not null)
            Navigation.NavigateTo("/home");
    }

    private async Task SelectProfile(int userId)
    {
        if (await SessionService.SelectProfileAsync(userId))
            Navigation.NavigateTo("/home");
        else
            _error = "That profile is no longer available. Refresh and choose another profile.";
    }
}
