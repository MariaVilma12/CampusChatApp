@page "/signin"
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject UserService UserService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Sign In</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="mb-4 text-center">
                        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill mb-3">Campus Chat</span>
                        <h1 class="h3 mb-2">Welcome back</h1>
                        <p class="text-muted mb-0">Choose your profile or create a new one to continue.</p>
                    </div>

                    @if (_users == null)
                    {
                        <div class="text-center text-muted">Loading profiles...</div>
                    }
                    else if (_users.Count == 0)
                    {
                        <div class="alert alert-info rounded-3">
                            No students have been created yet. Create the first profile to get started.
                        </div>
                    }
                    else
                    {
                        <div class="d-grid gap-2 mb-4">
                            @foreach (var user in _users)
                            {
                                <button class="btn btn-light border text-start d-flex align-items-center justify-content-between px-3 py-3 rounded-3" @onclick="() => SignInUser(user)">
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle text-white d-flex align-items-center justify-content-center" style="width: 38px; height: 38px; background: @user.AvatarColor; font-weight: 700;">@user.DisplayName.Substring(0,1).ToUpper()</div>
                                        <div>
                                            <div class="fw-semibold">@user.DisplayName</div>
                                            <small class="text-muted">@user.CourseStudying</small>
                                        </div>
                                    </div>
                                    <span class="text-primary">Open</span>
                                </button>
                            }
                        </div>
                    }

                    <div class="d-grid gap-2 mt-4">
                        <a class="btn btn-primary" href="/profile/create">Create a profile</a>
                        <a class="btn btn-outline-secondary" href="/profile/edit">Edit profile</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<User>? _users;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _users = UserService.GetAllUsers();
        var currentUser = await SessionService.GetCurrentUserAsync();
        if (currentUser is not null)
        {
            Navigation.NavigateTo("/home");
        }
        else
        {
            StateHasChanged();
        }
    }

    private async Task SignInUser(User user)
    {
        await SessionService.SetCurrentUserAsync(user);
        Navigation.NavigateTo("/home");
    }
}

