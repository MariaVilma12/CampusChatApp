@page "/chats/{id:int}"
@layout MainLayout
@using CampusChatApp.Components.Chat
@using CampusChatApp.Models
@using CampusChatApp.Services
@using System.Threading
@implements IDisposable
@inject SessionService SessionService
@inject ChatService ChatService
@inject UserService UserService
@inject CampusChatStateService CampusChatStateService

<PageTitle>Chat Details</PageTitle>

@if (_currentUser is null)
{
    <div class="container py-4">
        <div class="alert alert-warning">Please sign in to view this chat.</div>
    </div>
}
else if (_chat is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">Chat not found.</div>
    </div>
}
else if (!SessionService.CanAccessChat(_chat, _currentUser))
{
    <div class="container py-4">
        <div class="alert alert-warning">You do not have access to this direct chat.</div>
    </div>
}
else
{
    var otherUserId = _chat.User1Id == _currentUser.Id ? _chat.User2Id : _chat.User1Id;
    var otherUser = UserService.GetUser(otherUserId);

    <div class="container py-4">
        <h1>Chat with @((otherUser?.DisplayName ?? "Unknown"))</h1>
        <div class="card shadow-sm p-3 mb-3">
            @if (!_chat.Messages.Any())
            {
                <div class="alert alert-info">This chat has no messages yet.</div>
            }
            else
            {
                foreach (var message in _chat.Messages)
                {
                    <ChatMessage Message="message" />
                }
            }
        </div>
        <ChatInput ChatId="Id" />
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private User? _currentUser;
    private DirectChat? _chat;

    protected override async Task OnParametersSetAsync()
    {
        _currentUser = await SessionService.GetCurrentUserAsync();
        _chat = ChatService.GetChat(Id);
        CampusChatStateService.DataChanged += HandleDataChanged;
        await InvokeAsync(StateHasChanged);
    }

    private async void HandleDataChanged()
    {
        _chat = ChatService.GetChat(Id);
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CampusChatStateService.DataChanged -= HandleDataChanged;
    }
}
