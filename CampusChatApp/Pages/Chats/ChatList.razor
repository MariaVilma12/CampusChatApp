@page "/chats"
@layout MainLayout
@using CampusChatApp.Components.Chat
@using CampusChatApp.Models
@using CampusChatApp.Services
@using ChatMessageModel = CampusChatApp.Models.ChatMessage
@implements IDisposable
@inject SessionService SessionService
@inject ChatService ChatService
@inject CampusChatStateService CampusChatStateService

<PageTitle>Chats</PageTitle>

<div class="container-fluid py-4">
    <div class="mb-3">
        <h1>Chats</h1>
    </div>

    @if (_currentUser is null)
    {
        <div class="alert alert-warning">Please sign in to view your chats.</div>
    }
    else
    {
        @if (_currentUser.IsAuditUser)
        {
            <div class="alert alert-info">
                Auditor profiles can review conversations but cannot start or send direct messages.
                <a class="alert-link" href="/audit">Review conversations</a>
            </div>
        }
        else
        {
        <div class="row">
            <section class="col-12 col-md-8 col-lg-6 col-xl-5" aria-labelledby="recipients-heading">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h4" id="recipients-heading">Available people</h2>
                        <label class="form-label" for="recipient-search">Find someone to chat with</label>
                        <input id="recipient-search" class="form-control mb-3" @bind="_searchText" @bind:event="oninput" placeholder="Search by name" />

                        @{
                            var recipients = UserService.GetAllUsers()
                                .Where(user => user.Id != _currentUser.Id &&
                                    (string.IsNullOrWhiteSpace(_searchText) ||
                                     user.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase)))
                                .OrderBy(user => user.DisplayName)
                                .ToList();
                        }

                        @if (recipients.Count == 0)
                        {
                            <p class="text-muted mb-0">No people found.</p>
                        }
                        else
                        {
                            <div class="list-group">
                                @foreach (var recipient in recipients)
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span class="d-flex align-items-center gap-2">
                                            <span class="rounded-circle d-flex align-items-center justify-content-center text-white fw-semibold"
                                                  style="width: 36px; height: 36px; background: @recipient.AvatarColor;">
                                                @recipient.DisplayName.Substring(0, 1).ToUpperInvariant()
                                            </span>
                                            <span>@recipient.DisplayName</span>
                                        </span>
                                        <button class="btn btn-sm btn-primary" @onclick="() => OpenChat(recipient)">Chat</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </section>
        </div>
        }

        @if (!_currentUser.IsAuditUser && _openChatIds.Count > 0)
        {
            <div class="d-flex gap-3 align-items-end position-fixed bottom-0 end-0 p-3"
                 style="z-index: 1050; max-width: 100vw; overflow-x: auto;"
                 aria-label="Open chat windows">
                @foreach (var chatId in _openChatIds)
                {
                    var chat = ChatService.GetChat(chatId);
                    if (chat is null)
                    {
                        continue;
                    }

                    var otherUserId = chat.User1Id == _currentUser.Id ? chat.User2Id : chat.User1Id;
                    var otherUser = UserService.GetUser(otherUserId);

                    <section class="card shadow-lg flex-shrink-0" style="width: 320px; max-width: 85vw;"
                             aria-label="@($"Chat with {otherUser?.DisplayName ?? "Unknown"}")">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <strong class="text-truncate">@((otherUser?.DisplayName) ?? "Unknown")</strong>
                            <button class="btn-close ms-2" aria-label="Close chat"
                                    @onclick="() => CloseChat(chatId)"></button>
                        </div>
                        <div class="card-body p-3 overflow-auto" style="height: 280px;">
                            @if (chat.Messages.Count == 0)
                            {
                                <p class="small text-muted">Start the conversation.</p>
                            }
                            else
                            {
                                @foreach (var message in chat.Messages)
                                {
                                    <ChatMessage Message="message" CurrentUserId="_currentUser.Id" />
                                }
                            }
                        </div>
                        <div class="card-footer">
                            <ChatInput ChatId="chatId" />
                        </div>
                    </section>
                }
            </div>
        }
    }
</div>

@code {
    private User? _currentUser;
    private string _searchText = string.Empty;
    private readonly List<int> _openChatIds = new();

    [Inject]
    public UserService UserService { get; set; } = default!;

    protected override void OnInitialized()
    {
        CampusChatStateService.DataChanged += HandleDataChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _currentUser = await SessionService.GetCurrentUserAsync();
        StateHasChanged();
    }

    private void OpenChat(User recipient)
    {
        if (_currentUser is null)
            return;

        var existing = ChatService.GetAllChats()
            .FirstOrDefault(chat =>
                (chat.User1Id == _currentUser.Id && chat.User2Id == recipient.Id) ||
                (chat.User1Id == recipient.Id && chat.User2Id == _currentUser.Id));

        var chat = existing ?? ChatService.AddChat(new DirectChat
        {
            User1Id = _currentUser.Id,
            User2Id = recipient.Id,
            Messages = new List<ChatMessageModel>()
        });

        OpenChatById(chat.Id);
    }

    private void OpenChatById(int chatId)
    {
        if (!_openChatIds.Contains(chatId))
            _openChatIds.Add(chatId);
    }

    private void CloseChat(int chatId)
    {
        _openChatIds.Remove(chatId);
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CampusChatStateService.DataChanged -= HandleDataChanged;
    }
}
