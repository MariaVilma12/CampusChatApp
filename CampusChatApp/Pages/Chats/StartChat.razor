@page "/chats/start"
@layout MainLayout

<PageTitle>Start Chat</PageTitle>

<div class="container py-4">
    <h1>Start a direct chat</h1>
    <form class="card shadow-sm p-3">
        <div class="mb-3">
            <label class="form-label">Recipient</label>
            <input class="form-control" placeholder="Search for a student" />
        </div>
        <button type="submit" class="btn btn-primary">Start conversation</button>
    </form>
</div>
