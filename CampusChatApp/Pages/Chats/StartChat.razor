@page "/chats/start"
@layout MainLayout
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject UserService UserService
@inject ChatService ChatService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Start Chat</PageTitle>

<div class="container py-4">
    <h1>Start a direct chat</h1>

    @if (_currentUser is null)
    {
        <div class="alert alert-warning">Please sign in to start a chat.</div>
    }
    else if (_currentUser.IsAuditUser)
    {
        <div class="alert alert-info">
            Auditor profiles can review existing conversations but cannot start direct messages.
            <a class="alert-link" href="/audit">Review conversations</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm p-3">
            <div class="mb-3">
                <label class="form-label">Recipient</label>
                <input class="form-control" @bind="_searchText" @bind:event="oninput" placeholder="Search for a student" />
            </div>

            @if (string.IsNullOrWhiteSpace(_searchText))
            {
                <div class="alert alert-info">Search for a student to start a chat.</div>
            }
            else
            {
                var matches = UserService.GetAllUsers()
                    .Where(u => u.Id != _currentUser.Id && u.DisplayName.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
                    .ToList();

                if (matches.Count == 0)
                {
                    <div class="alert alert-info">No student matches your search.</div>
                }
                else
                {
                    <ul class="list-group">
                        @foreach (var user in matches)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span>@user.DisplayName</span>
                                <button class="btn btn-sm btn-primary" @onclick="() => CreateChat(user)">Start</button>
                            </li>
                        }
                    </ul>
                }
            }
        </div>
    }
</div>

@code {
    private User? _currentUser;
    private string _searchText = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _currentUser = await SessionService.GetCurrentUserAsync();
        StateHasChanged();
    }

    private void CreateChat(User recipient)
    {
        if (_currentUser is null || _currentUser.IsAuditUser)
            return;

        var existing = ChatService.GetAllChats()
            .FirstOrDefault(c =>
                (c.User1Id == _currentUser.Id && c.User2Id == recipient.Id) ||
                (c.User1Id == recipient.Id && c.User2Id == _currentUser.Id));

        if (existing is not null)
        {
            Navigation.NavigateTo($"/chats/{existing.Id}");
            return;
        }

        var chat = new DirectChat
        {
            User1Id = _currentUser.Id,
            User2Id = recipient.Id,
            Messages = new List<CampusChatApp.Models.ChatMessage>()
        };

        var created = ChatService.AddChat(chat);
        Navigation.NavigateTo($"/chats/{created.Id}");
    }
}