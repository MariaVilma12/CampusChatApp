@page "/profile/create"
@layout MainLayout
@using CampusChatApp.Services
@inject UserService UserService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Create Profile</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <h1 class="h3 mb-3">Create profile</h1>

                    @if (!string.IsNullOrWhiteSpace(_statusMessage))
                    {
                        <div class="alert @(_isError ? "alert-danger" : "alert-success") rounded-3">@_statusMessage</div>
                    }

                    <EditForm Model="this" OnValidSubmit="CreateUserProfile">
                        <div class="mb-3">
                            <label class="form-label">Display name</label>
                            <InputText class="form-control" @bind-Value="_displayName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Biography</label>
                            <InputTextArea class="form-control" @bind-Value="_about" rows="4" />
                        </div>
                        <div class="row g-3">
                            <div class="col-md-8">
                                <label class="form-label">Course studying</label>
                                <InputText class="form-control" @bind-Value="_courseStudying" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Study year</label>
                                <InputNumber class="form-control" @bind-Value="_studyYear" />
                            </div>
                        </div>
                        <div class="mt-3">
                            <label class="form-label">Avatar colour</label>
                            <div class="d-flex align-items-center gap-3">
                                <InputText type="color" class="form-control form-control-color" style="width: 68px; min-width: 68px; height: 44px;" @bind-Value="_avatarColor" />
                                <div class="small text-muted">This colour is shown beside your posts and profile.</div>
                            </div>
                        </div>
                        <div class="mt-3 form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="_isAuditUser" />
                            <label class="form-check-label">Audit role (can read all threads and direct chats)</label>
                        </div>
                        <button type="submit" class="btn btn-primary mt-4">Create profile</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string _displayName = string.Empty;
    private string _about = string.Empty;
    private string _courseStudying = string.Empty;
    private int _studyYear = 1;
    private string _avatarColor = "#4f46e5";
    private bool _isAuditUser;
    private string _statusMessage = string.Empty;
    private bool _isError;

    private async Task CreateUserProfile()
    {
        try
        {
            var user = UserService.CreateProfile(_displayName, _about, _courseStudying, _studyYear, _avatarColor, _isAuditUser);
            await SessionService.SetCurrentUserAsync(user);
            _statusMessage = "Profile created successfully.";
            _isError = false;
            await Task.Delay(200);
            Navigation.NavigateTo("/profile");
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isError = true;
        }
    }
}
