@page "/signup"
@page "/profile/create"
@layout MainLayout

<PageTitle>Demo profiles</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h1 class="h3">Demo profiles</h1>
                <p class="text-muted">
                    This version uses a small set of in-memory demo profiles instead of account registration.
                    Choose a profile to continue; profile changes and conversations reset when the application restarts.
                </p>
                <a class="btn btn-primary align-self-start" href="/signin">Choose a profile</a>
            </div>
        </div>
    </div>
</div>
