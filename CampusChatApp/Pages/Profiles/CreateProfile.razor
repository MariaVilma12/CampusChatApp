@page "/signup"
@page "/profile/create"
@layout MainLayout
@using CampusChatApp.Services
@inject UserService UserService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Create profile</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h1 class="h3">Create profile</h1>
                <p class="text-muted">
                    This is a demo profile, not a protected account. Anyone can select it, and it resets when the app restarts.
                    Do not enter real or sensitive information.
                </p>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <div class="alert alert-danger" role="alert">@_error</div>
                }
                <EditForm Model="this" OnValidSubmit="Create">
                    <div class="mb-3">
                        <label class="form-label" for="display-name">Display name</label>
                        <InputText id="display-name" class="form-control" @bind-Value="_displayName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="about">Biography</label>
                        <InputTextArea id="about" class="form-control" @bind-Value="_about" rows="4" />
                    </div>
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label" for="course">Course studying</label>
                            <InputText id="course" class="form-control" @bind-Value="_courseStudying" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label" for="year">Study year</label>
                            <InputNumber id="year" class="form-control" @bind-Value="_studyYear" min="1" max="5" />
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="form-label" for="avatar">Avatar colour</label>
                        <InputText id="avatar" type="color" class="form-control form-control-color" @bind-Value="_avatarColor" />
                    </div>
                    <button type="submit" class="btn btn-primary mt-4" disabled="@_saving">Create profile</button>
                    <a class="btn btn-outline-secondary mt-4 ms-2" href="/signin">Sign in</a>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    private string _displayName = string.Empty;
    private string _about = string.Empty;
    private string _courseStudying = string.Empty;
    private int? _studyYear;
    private string _avatarColor = "#0f766e";
    private string _error = string.Empty;
    private bool _saving;

    private async Task Create()
    {
        if (_saving)
            return;

        _saving = true;
        try
        {
            var user = UserService.CreateProfile(_displayName, _about, _courseStudying, _studyYear, _avatarColor);
            if (await SessionService.SelectProfileAsync(user.Id))
                Navigation.NavigateTo("/home");
            else
                _error = "The profile could not be selected. Please choose it on the sign-in page.";
        }
        catch (ArgumentException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
