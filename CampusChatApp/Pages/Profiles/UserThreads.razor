@page "/profiles/{id:int}/threads"
@layout MainLayout
@using CampusChatApp.Components.Threads
@using CampusChatApp.Models
@using CampusChatApp.Services
@implements IDisposable
@inject UserService UserService
@inject CampusChatStateService CampusChatStateService

<PageTitle>My Threads</PageTitle>

@if (_user is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">User not found.</div>
    </div>
}
else
{
    <div class="container py-4">
        <h1>@_user.DisplayName's Threads</h1>
        <JoinedThreads User="_user" />
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private User? _user;

    protected override void OnInitialized()
    {
        CampusChatStateService.DataChanged += HandleDataChanged;
    }

    protected override void OnParametersSet()
    {
        _user = UserService.GetUser(Id);
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CampusChatStateService.DataChanged -= HandleDataChanged;
    }
}
