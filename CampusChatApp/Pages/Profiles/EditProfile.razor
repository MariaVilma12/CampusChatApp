@page "/profile/edit"
@layout MainLayout

<PageTitle>Edit Profile</PageTitle>

<div class="container py-4">
    <h1>Edit Profile</h1>
    <form class="card shadow-sm p-3">
        <div class="mb-3">
            <label class="form-label">Display Name</label>
            <input class="form-control" value="Campus Student" />
        </div>
        <div class="mb-3">
            <label class="form-label">Biography</label>
            <textarea class="form-control" rows="4">Active member of the campus community.</textarea>
        </div>
        <button type="submit" class="btn btn-primary">Save changes</button>
    </form>
</div>
