@page "/profile/edit"
@layout MainLayout
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject SessionService SessionService
@inject UserService UserService
@inject NavigationManager Navigation

<PageTitle>Edit Profile</PageTitle>

@if (_currentUser is null)
{
    <div class="container py-4">
        <div class="alert alert-warning">Please sign in to edit your profile.</div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4 p-md-5">
                        <h1 class="h3 mb-3">Edit profile</h1>

                        @if (!string.IsNullOrWhiteSpace(_statusMessage))
                        {
                            <div class="alert @(_isError ? "alert-danger" : "alert-success") rounded-3">@_statusMessage</div>
                        }

                        <EditForm Model="this" OnValidSubmit="SaveProfile">
                            <div class="mb-3">
                                <label class="form-label">Display name</label>
                                <InputText class="form-control" @bind-Value="_displayName" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Biography</label>
                                <InputTextArea class="form-control" @bind-Value="_about" rows="4" />
                            </div>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label">Course studying</label>
                                    <InputText class="form-control" @bind-Value="_courseStudying" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Study year</label>
                                    <InputNumber class="form-control" @bind-Value="_studyYear" />
                                </div>
                            </div>
                            <div class="mt-3">
                                <label class="form-label">Avatar colour</label>
                                <div class="d-flex align-items-center gap-3">
                                    <InputText type="color" class="form-control form-control-color" style="width: 68px; min-width: 68px; height: 44px;" @bind-Value="_avatarColor" />
                                    <div class="small text-muted">Your selected colour updates your profile badge.</div>
                                </div>
                            </div>
                            <button type="submit" class="btn btn-primary mt-4">Save changes</button>
                        </EditForm>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private User? _currentUser;
    private string _displayName = string.Empty;
    private string _about = string.Empty;
    private string _courseStudying = string.Empty;
    private int? _studyYear;
    private string _avatarColor = "#0f766e";
    private string _statusMessage = string.Empty;
    private bool _isError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _currentUser = await SessionService.GetCurrentUserAsync();
        if (_currentUser is null)
        {
            StateHasChanged();
            return;
        }

        _displayName = _currentUser.DisplayName;
        _about = _currentUser.About;
        _courseStudying = _currentUser.CourseStudying;
        _studyYear = _currentUser.StudyYear;
        _avatarColor = _currentUser.AvatarColor;
        StateHasChanged();
    }

    private void SaveProfile()
    {
        if (_currentUser is null)
        {
            _statusMessage = "Please sign in to edit your profile.";
            _isError = true;
            return;
        }

        try
        {
            UserService.UpdateProfile(_currentUser, _displayName, _about, _courseStudying, _studyYear, _avatarColor);
            _statusMessage = "Profile updated successfully.";
            _isError = false;
            Navigation.NavigateTo("/profile");
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message;
            _isError = true;
        }
    }
}
