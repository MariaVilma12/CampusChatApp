@page "/profile"
@page "/profiles/{id:int}"
@layout MainLayout
@using CampusChat.Services
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject UserService UserService
@inject SessionService SessionService
@inject NavigationManager Navigation

<PageTitle>Profile</PageTitle>

@if (user is null)
{
    <div class="container py-4">
        <div class="alert alert-danger">User not found.</div>
    </div>
}
else
{
    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>@user.DisplayName</h1>
            @if (isOwnProfile)
            {
                <button class="btn btn-primary" @onclick="NavigateToEditProfile">Edit profile</button>
            }
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <p><strong>About:</strong> @user.About</p>
                <p><strong>Course studying:</strong> @user.CourseStudying</p>
                <p><strong>Year:</strong> @user.StudyYear</p>
                <p><strong>Joined threads:</strong> @string.Join(", ", user.JoinedThreadIds)</p>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private User? user;
    private bool isOwnProfile;

    protected override async Task OnParametersSetAsync()
    {
        var currentUser = await SessionService.GetCurrentUserAsync();

        if (Id > 0)
        {
            user = UserService.GetUser(Id);
            isOwnProfile = currentUser is not null && user is not null && currentUser.Id == user.Id;
            return;
        }

        user = currentUser ?? UserService.GetUser(1);
        isOwnProfile = currentUser is not null && user is not null;
    }

    private void NavigateToEditProfile()
    {
        Navigation.NavigateTo("/profile/edit");
    }
}
