@page "/profile"
@page "/profiles/{id:int}"
@layout MainLayout
@using CampusChatApp.Components.Threads
@using CampusChatApp.Models
@using CampusChatApp.Services
@implements IDisposable
@inject UserService UserService
@inject SessionService SessionService
@inject CampusChatStateService CampusChatStateService
@inject NavigationManager Navigation

<PageTitle>Profile</PageTitle>

@if (Id > 0 || _user is not null)
{
    if (_user is null)
    {
        <div class="container py-4">
            <div class="alert alert-danger">User not found.</div>
        </div>
    }
    else
    {
        <div class="container py-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <p class="text-uppercase text-primary small fw-semibold mb-1">Profile</p>
                    <h1 class="h3 mb-0">@_user.DisplayName</h1>
                </div>
                <div class="d-flex gap-2">
                    @if (_isOwnProfile)
                    {
                        <button class="btn btn-primary" @onclick="NavigateToEditProfile">Edit profile</button>
                    }
                    @if (_isSignedIn)
                    {
                        <button class="btn btn-outline-danger" @onclick="SignOutCurrentProfile">Sign out</button>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary" href="/signin">Sign in</a>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle me-3" style="width: 56px; height: 56px; background: @_user.AvatarColor; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold; font-size: 1.2rem;">@_user.DisplayName.Substring(0, 1).ToUpper()</div>
                        <div>
                            <div class="fw-bold fs-5">@_user.DisplayName</div>
                            <small class="text-muted">
                                @_user.CourseStudying
                                @if (_user.StudyYear.HasValue)
                                {
                                    <span> · Year @_user.StudyYear</span>
                                }
                            </small>
                            @if (_user.IsAuditUser)
                            {
                                <div class="mt-2 badge bg-danger-subtle text-danger rounded-pill">Audit role</div>
                            }
                            else if (_user.Role == UserRole.Lecturer)
                            {
                                <div class="mt-2 badge bg-success-subtle text-success rounded-pill">Lecturer</div>
                            }
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <div class="text-muted small mb-1">About</div>
                                <div>@_user.About</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3 h-100">
                                <div class="text-muted small mb-1">Study information</div>
                                <div><strong>Course:</strong> @_user.CourseStudying</div>
                                <div><strong>Year:</strong> @(_user.StudyYear?.ToString() ?? "Not specified")</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <strong>Joined threads:</strong>
                        <JoinedThreads User="_user" />
                    </div>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="container py-4">
        <div class="alert alert-warning">Please sign in to view your profile.</div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private User? _user;
    private bool _isOwnProfile;
    private bool _isSignedIn;
    private bool _interactive;

    protected override void OnInitialized()
    {
        CampusChatStateService.DataChanged += HandleDataChanged;
    }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        Id = 0;
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_interactive)
            await LoadProfile();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        _interactive = true;
        await LoadProfile();
        StateHasChanged();
    }

    private async Task LoadProfile()
    {
        var currentUser = await SessionService.GetCurrentUserAsync();
        _isSignedIn = currentUser is not null;

        if (Id > 0)
        {
            _user = UserService.GetUser(Id);
            _isOwnProfile = currentUser is not null && _user is not null && currentUser.Id == _user.Id;
            return;
        }

        if (currentUser is not null)
        {
            _user = currentUser;
            _isOwnProfile = true;
            return;
        }

        _user = null;
        _isOwnProfile = false;
    }

    private async Task SignOutCurrentProfile()
    {
        await SessionService.LogoutAsync();
        _isSignedIn = false;
        Navigation.NavigateTo("/");
    }

    private void NavigateToEditProfile()
    {
        Navigation.NavigateTo("/profile/edit");
    }

    private async void HandleDataChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CampusChatStateService.DataChanged -= HandleDataChanged;
    }
}
