@page "/threads/private"
@layout MainLayout
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject SessionService SessionService
@inject ThreadService ThreadService
@inject NavigationManager Navigation

<PageTitle>Join Private Thread</PageTitle>

<div class="container py-4">
    <h1>Join a private thread</h1>

    @if (_currentUser is null)
    {
        <div class="alert alert-warning">Please sign in first.</div>
    }
    else if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isSuccess ? "alert-success" : "alert-danger")">@_message</div>
    }

    <EditForm Model="this" OnValidSubmit="JoinThread">
        <div class="card shadow-sm p-3">
            <div class="mb-3">
                <label class="form-label">Thread ID</label>
                <InputNumber class="form-control" @bind-Value="_threadId" />
            </div>
            <div class="mb-3">
                <label class="form-label">Invite code</label>
                <InputText class="form-control" @bind-Value="_code" placeholder="Enter join code" />
            </div>
            <button type="submit" class="btn btn-primary">Join thread</button>
        </div>
    </EditForm>
</div>

@code {
    private User? _currentUser;
    private int _threadId;
    private string _code = string.Empty;
    private string _message = string.Empty;
    private bool _isSuccess;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await SessionService.GetCurrentUserAsync();
    }

    private async Task JoinThread()
    {
        if (_currentUser is null)
        {
            _message = "Please sign in first.";
            _isSuccess = false;
            return;
        }

        var thread = ThreadService.GetThread(_threadId);
        if (thread is null)
        {
            _message = "Thread not found.";
            _isSuccess = false;
            return;
        }

        if (!ThreadService.CanAccessThread(thread, _currentUser, _code))
        {
            _message = "Incorrect code. This private thread requires a valid access code.";
            _isSuccess = false;
            return;
        }

        if (!_currentUser.JoinedThreadIds.Contains(_threadId))
            _currentUser.JoinedThreadIds.Add(_threadId);

        _message = $"You joined '{thread.Name}'.";
        _isSuccess = true;
        await Task.Delay(300);
        Navigation.NavigateTo($"/threads/{_threadId}");
    }
}
