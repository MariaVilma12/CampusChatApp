@page "/threads/create"
@layout MainLayout
@using CampusChatApp.Helpers
@using CampusChatApp.Models
@using CampusChatApp.Services
@inject SessionService SessionService
@inject ThreadService ThreadService
@inject NavigationManager Navigation

<PageTitle>Create Thread</PageTitle>

<div class="container py-4">
    <h1>Create a thread</h1>

    @if (!string.IsNullOrWhiteSpace(_message))
    {
        <div class="alert @(_isSuccess ? "alert-success" : "alert-danger")">@_message</div>
    }

    <EditForm Model="this" OnValidSubmit="CreateNewThread">
        <div class="card shadow-sm p-3">
            <div class="mb-3">
                <label class="form-label">Thread title</label>
                <InputText class="form-control" @bind-Value="_threadName" placeholder="Name your thread" />
            </div>
            <div class="mb-3">
                <label class="form-label">Access</label>
                <InputSelect class="form-select" @bind-Value="_selectedAccessType">
                    <option value="" disabled>Select access type</option>
                    <option value="public">Public</option>
                    <option value="private">Private</option>
                </InputSelect>
            </div>
            @if (_selectedAccessType == "private")
            {
                <div class="mb-3">
                    <label class="form-label">Invite code</label>
                    <InputText class="form-control" @bind-Value="_accessCode" placeholder="Enter code for private thread" />
                </div>
            }
            <button type="submit" class="btn btn-primary">Create</button>
        </div>
    </EditForm>
</div>

@code {
    private string _threadName = string.Empty;
    private string _accessCode = string.Empty;
    private string _selectedAccessType = string.Empty;
    private string _message = string.Empty;
    private bool _isSuccess;

    private async Task CreateNewThread()
    {
        var user = await SessionService.GetCurrentUserAsync();
        if (user is null)
        {
            _message = "Please sign in before creating a thread.";
            _isSuccess = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(_threadName))
        {
            _message = "Thread name cannot be empty.";
            _isSuccess = false;
            return;
        }

        var normalizedName = _threadName.Trim();
        if (normalizedName.Length > Constants.MaxThreadTitleLength)
        {
            _message = $"Thread name must be {Constants.MaxThreadTitleLength} characters or fewer.";
            _isSuccess = false;
            return;
        }

        if (_selectedAccessType is not ("public" or "private"))
        {
            _message = "Select an access type.";
            _isSuccess = false;
            return;
        }

        if (_selectedAccessType == "private")
        {
            var cleanedAccessCode = _accessCode.Trim();
            if (string.IsNullOrWhiteSpace(cleanedAccessCode))
            {
                _message = "Private threads require an access code.";
                _isSuccess = false;
                return;
            }

            if (cleanedAccessCode.Length > Constants.MaxAccessCodeLength)
            {
                _message = $"Access code must be {Constants.MaxAccessCodeLength} characters or fewer.";
                _isSuccess = false;
                return;
            }
        }

        var newThread = new CampusChatApp.Models.Thread
        {
            Name = normalizedName,
            IsPrivate = _selectedAccessType == "private",
            AccessCode = _selectedAccessType == "private" ? _accessCode.Trim() : null,
            Posts = new List<Post>()
        };

        ThreadService.AddThread(newThread);
        user.JoinedThreadIds.Add(newThread.Id);
        _message = $"Thread '{newThread.Name}' created successfully.";
        _isSuccess = true;

        Navigation.NavigateTo($"/threads/{newThread.Id}");
    }
}
