@page "/threads/create"
@layout MainLayout

<PageTitle>Create Thread</PageTitle>

<div class="container py-4">
    <h1>Create a thread</h1>
    <form class="card shadow-sm p-3">
        <div class="mb-3">
            <label class="form-label">Thread title</label>
            <input class="form-control" placeholder="Name your thread" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea class="form-control" rows="4" placeholder="Describe the discussion topic"></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Create</button>
    </form>
</div>
