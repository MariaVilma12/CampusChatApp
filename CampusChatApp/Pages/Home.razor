@page "/home"
@layout MainLayout
@using CampusChatApp.Data
@using CampusChatApp.Services
@inject SessionService SessionService
@inject NavigationManager Navigation

@if (_isChecking)
{
    <div class="container py-4">
        <div class="alert alert-info">Checking your session...</div>
    </div>
}
else if (_currentUser is null)
{
    <div class="container py-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h1 class="h3 mb-3">Welcome to Campus Chat!</h1>
            <p class="text-muted mb-4">
                Your campus hub to connect with fellow students, join course threads, and collaborate seamlessly across the college community.
            </p>
            <p class="mb-4">
                Explore discussions, find study groups, or reach out to peers directly.
            </p>

            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-primary" href="/threads">Browse threads</a>
                <a class="btn btn-outline-primary" href="/chats">Messages</a>
                <a class="btn btn-outline-secondary" href="/profile">Profile</a>
            </div>
        </div>
    </div>
}
else
{
    var recentThreads = AppStore.Threads
        .OrderByDescending(t => t.LastUpdatedAt)
        .Take(5)
        .ToList();

    <div class="container py-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
            <div>
                <p class="text-uppercase text-primary small fw-semibold mb-1">Overview</p>
                <h1 class="h3 mb-0">Welcome, @_currentUser.DisplayName</h1>
            </div>
            <a class="btn btn-primary mt-3 mt-md-0" href="/threads">Browse threads</a>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <h2 class="h5 mb-0">Your joined threads</h2>
                            <span class="badge bg-light text-dark">@_currentUser.JoinedThreadIds.Count</span>
                        </div>

                        @if (_currentUser.JoinedThreadIds.Count == 0)
                        {
                            <div class="alert alert-info rounded-3 mb-0">You have not joined any thread yet.</div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var threadId in _currentUser.JoinedThreadIds)
                                {
                                    var thread = AppStore.Threads.FirstOrDefault(t => t.Id == threadId);
                                    if (thread is not null)
                                    {
                                        var unread = _currentUser.UnreadThreadCounts.TryGetValue(thread.Id, out var value) ? value : 0;
                                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center px-0" href="/threads/@thread.Id">
                                            <div>
                                                <div class="fw-semibold">@thread.Name</div>
                                                <small class="text-muted">@(thread.IsPrivate ? "Private thread" : "Public thread")</small>
                                            </div>
                                            @if (unread > 0)
                                            {
                                                <span class="badge bg-warning text-dark rounded-pill">@unread</span>
                                            }
                                        </a>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle me-3" style="width: 48px; height: 48px; background: @_currentUser.AvatarColor; color: white; display: flex; align-items: center; justify-content: center; font-weight: bold;">@_currentUser.DisplayName.Substring(0, 1).ToUpper()</div>
                            <div>
                                <div class="fw-semibold">@_currentUser.DisplayName</div>
                                <small class="text-muted">@_currentUser.CourseStudying</small>
                            </div>
                        </div>
                        @if (_currentUser.StudyYear.HasValue)
                        {
                            <div class="small text-muted">Year @_currentUser.StudyYear</div>
                        }
                        else if (_currentUser.IsAuditUser)
                        {
                            <div class="small text-muted">Campus reviewer</div>
                        }
                        @if (_currentUser.IsAuditUser)
                        {
                            <div class="mt-3 badge bg-danger-subtle text-danger rounded-pill">Audit role active</div>
                        }
                    </div>
                </div>

                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-3">Direct chats</h2>
                        @if (!AppStore.Chats.Any(c => c.User1Id == _currentUser.Id || c.User2Id == _currentUser.Id))
                        {
                            <div class="alert alert-info rounded-3 mb-0">You do not have any direct chats yet.</div>
                        }
                        else
                        {
                            <div class="d-grid gap-2">
                                @foreach (var chat in AppStore.Chats.Where(c => c.User1Id == _currentUser.Id || c.User2Id == _currentUser.Id).Take(4))
                                {
                                    var otherUserId = chat.User1Id == _currentUser.Id ? chat.User2Id : chat.User1Id;
                                    var otherUser = AppStore.Users.FirstOrDefault(u => u.Id == otherUserId);
                                    <a class="d-flex align-items-center gap-2 text-decoration-none text-body rounded-3 border p-2" href="/chats/@chat.Id">
                                        <div class="rounded-circle" style="width: 28px; height: 28px; background: @(otherUser?.AvatarColor ?? "#4f46e5"); color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: bold;">@(otherUser?.DisplayName.Substring(0,1).ToUpper() ?? "?")</div>
                                        <span>@(otherUser?.DisplayName ?? "Unknown")</span>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
private CampusChatApp.Models.User? _currentUser;
private bool _isChecking = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

    _currentUser = await SessionService.GetCurrentUserAsync();
    _isChecking = false;

    if (_currentUser is null)
        {
            Navigation.NavigateTo("/signin");
        }
        else
        {
            StateHasChanged();
        }
    }
}
