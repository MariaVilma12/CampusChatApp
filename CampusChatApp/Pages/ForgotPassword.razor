@page "/forgot-password"
@layout MainLayout

<PageTitle>Password recovery</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <h1 class="h3">Password recovery</h1>
                <p class="text-muted">
                    Demo profiles do not use passwords. Return to the profile chooser to select an account.
                </p>
                <a class="btn btn-primary align-self-start" href="/signin">Choose a profile</a>
            </div>
        </div>
    </div>
</div>
